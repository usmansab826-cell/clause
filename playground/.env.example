# ---------- Chat model (LangChain init_chat_model) ----------
# Local and free with Ollama:  ollama pull gemma3:4b
CHAT_PROVIDER=
CHAT_MODEL=
CHAT_TEMPERATURE=0.1
CHAT_BASE_URL=
CHAT_API_KEY=
# Other providers (install the package first):
#   uv add langchain-anthropic   -> CHAT_PROVIDER=anthropic  CHAT_MODEL=<model id>  CHAT_API_KEY=sk-ant-...
#   uv add langchain-openai      -> CHAT_PROVIDER=openai     CHAT_MODEL=<model id>  CHAT_API_KEY=sk-...
#   uv add langchain-google-genai -> CHAT_PROVIDER=google_genai CHAT_MODEL=<model id> CHAT_API_KEY=...
# Offline test mode (no model at all, extractive answers): CHAT_PROVIDER=fake

# ---------- Embeddings (LangChain init_embeddings) ----------
# Local with Ollama:  ollama pull nomic-embed-text
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
# Offline test mode: EMBEDDING_PROVIDER=fake
